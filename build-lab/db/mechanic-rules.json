{
  "about": "Tags for the interaction index. A line gets a tag when its text matches `text` (case-insensitive regex), any parsed mod name matches `mod`, any parsed mod has keyword flag `kw` or mod flag `flag`, or any mod tag has a var matching `cond`. Add rules here for mechanics PoB doesn't parse; build-game-db.py applies them to every line.",
  "rules": [
    { "tag": "conversion", "text": "convert|as extra|gained as|added as", "mod": "ConvertTo|GainAs|AsExtra" },
    { "tag": "counts-as", "text": "\\binstead\\b|counts? as|treated as|considered" },
    { "tag": "trigger", "text": "trigger", "mod": "Trigger" },
    { "tag": "restriction", "text": "\\bcannot\\b|can't|\\bnever\\b" },
    { "tag": "more-multiplier", "text": "\\bmore\\b|double damage|deal double", "mod": "DoubleDamage" },
    { "tag": "lucky", "text": "\\blucky\\b|unlucky" },
    { "tag": "per-scaling", "text": "\\bper\\b(?! second)(?! minute)" },
    { "tag": "attribute-scaling", "text": "per \\d* ?(strength|dexterity|intelligence|attribute)" },
    { "tag": "gem-levels", "text": "to level of|gem level|levels? of (all|socketed)" },
    { "tag": "socketed", "text": "socketed" },

    { "tag": "ignite", "text": "ignit", "kw": "Ignite" },
    { "tag": "poison", "text": "poison", "kw": "Poison" },
    { "tag": "bleed", "text": "bleed", "kw": "Bleed" },
    { "tag": "shock", "text": "shock" },
    { "tag": "chill-freeze", "text": "chill|freez" },
    { "tag": "exotic-ailment", "text": "brittle|\\bsap\\b|scorch" },
    { "tag": "damage-over-time", "text": "damage over time|degen", "flag": "Dot" },
    { "tag": "crit", "text": "critical", "mod": "Crit" },
    { "tag": "impale", "text": "impale", "mod": "Impale" },
    { "tag": "penetration", "text": "penetrat|exposure|enemies .*resistance|resistance.*enemies" },

    { "tag": "minion", "text": "minion|spectre|zombie|skeleton|golem|raised|summoned|animated", "mod": "^Minion" },
    { "tag": "totem", "text": "totem" },
    { "tag": "trap-mine", "text": "\\btraps?\\b|\\bmines?\\b" },
    { "tag": "brand", "text": "\\bbrands?\\b" },
    { "tag": "aura", "text": "\\bauras?\\b" },
    { "tag": "curse", "text": "curse|\\bhex" },
    { "tag": "herald", "text": "herald" },
    { "tag": "warcry", "text": "warcr" },
    { "tag": "channelling", "text": "channel" },
    { "tag": "projectile", "text": "projectile", "flag": "Projectile" },
    { "tag": "area", "text": "area of effect", "flag": "Area" },
    { "tag": "spell", "text": "\\bspells?\\b", "flag": "Spell" },
    { "tag": "attack", "text": "\\battacks?\\b", "flag": "Attack" },
    { "tag": "melee", "text": "\\bmelee\\b", "flag": "Melee" },

    { "tag": "reservation", "text": "reserv" },
    { "tag": "skill-cost", "text": "\\bcosts?\\b" },
    { "tag": "life-cost", "text": "life instead of mana|cost life|life cost" },
    { "tag": "leech", "text": "leech" },
    { "tag": "regen", "text": "regenerat" },
    { "tag": "recoup", "text": "recoup|recover" },
    { "tag": "on-kill", "text": "on kill|when you kill|killed" },
    { "tag": "on-hit", "text": "on hit|when you hit" },
    { "tag": "charges", "text": "(power|frenzy|endurance) charge" },
    { "tag": "buff", "text": "onslaught|unholy might|elusive|arcane surge|fortif|\\brage\\b|tailwind|adrenaline" },
    { "tag": "flask", "text": "flask|tincture" },

    { "tag": "block", "text": "\\bblock" },
    { "tag": "suppression", "text": "suppress" },
    { "tag": "armour", "text": "\\barmour\\b" },
    { "tag": "evasion", "text": "evasion|evade" },
    { "tag": "energy-shield", "text": "energy shield" },
    { "tag": "ward", "text": "\\bward\\b" },
    { "tag": "max-resistance", "text": "maximum .*resistance" },
    { "tag": "damage-taken", "text": "damage taken|take .*damage|taken as" }
  ]
}
